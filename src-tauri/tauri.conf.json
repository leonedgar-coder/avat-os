{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "avat-os",
  "version": "0.1.0",
  "identifier": "com.avatos.app",
  "build": {
    "beforeDevCommand": "npm run fetch:tracking && npm run build:avatar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run fetch:tracking && npm run build:avatar && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "avat-os",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
