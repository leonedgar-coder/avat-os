{
  "name": "avat-os",
  "version": "0.1.0",
  "description": "Estudio de VTuber open source: avatar 3D + escenas, audio y grabación",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "build:avatar": "vite build --config avatar/vite.config.js",
    "fetch:tracking": "node scripts/fetch-tracking.mjs",
    "test:vowels": "node scripts/test-vowels.ts",
    "test:smoothing": "node scripts/test-smoothing.ts",
    "test:blink": "node scripts/test-blink.ts",
    "test:body": "node scripts/test-body.ts"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.2",
    "@pixiv/three-vrm": "^3.5.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/three": "^0.187.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
